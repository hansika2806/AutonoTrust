# VadaChain Environment Variables
# Copy this file to .env and fill in your values

# === LLM Keys ===
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# === Blockchain Wallets ===
# All wallets must be funded with Polygon Amoy test MATIC
# Faucet: https://faucet.polygon.technology/

CLIENT_PRIVATE_KEY=0x...
CLIENT_ADDRESS=0x...

AUDITOR_PRIVATE_KEY=0x...
AUDITOR_ADDRESS=0x...

EXECUTOR_1_PRIVATE_KEY=0x...
EXECUTOR_1_ADDRESS=0x...

EXECUTOR_2_PRIVATE_KEY=0x...
EXECUTOR_2_ADDRESS=0x...

DEPLOYER_PRIVATE_KEY=0x...

# === RPC ===
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your_key_here

# === Contract ===
CONTRACT_ADDRESS=  # filled after Phase 2 deploy

# === Chroma ===
CHROMA_PERSIST_DIR=./chroma_data
